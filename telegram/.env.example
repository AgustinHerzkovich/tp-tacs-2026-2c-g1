# Copiar a .env (no versionado) y completar. Lo lee scripts/deploy.sh.
GCP_PROJECT_ID=planazo-tacs-g1-2026
GCP_REGION=us-central1
FUNCTION_NAME=telegram-webhook

# URLs publicas de produccion.
BACKEND_URL=https://planazo-prod-backend-5zx6pudlha-uc.a.run.app
FRONTEND_URL=https://planazo-prod-frontend-5zx6pudlha-uc.a.run.app
KEYCLOAK_URL=https://planazo-prod-keycloak-5zx6pudlha-uc.a.run.app
KEYCLOAK_REALM=solnotfound
KEYCLOAK_TELEGRAM_BOT_CLIENT_ID=solnotfoundTelegramBot

# Secretos: deploy.sh los sube a Secret Manager. Nunca los commitees.
# Token que da BotFather.
TELEGRAM_BOT_TOKEN=
# Client secret del cliente solnotfoundTelegramBot en el Keycloak de produccion.
KEYCLOAK_TELEGRAM_BOT_CLIENT_SECRET=
# Tiene que ser el mismo valor que TELEGRAM_API_TOKEN del backend en Cloud Run.
TELEGRAM_API_TOKEN=
# Opcional: si queda vacio, deploy.sh genera uno nuevo en cada deploy.
TELEGRAM_WEBHOOK_SECRET=

# Nombres de los secretos en Secret Manager (opcionales, estos son los valores por defecto).
SECRET_NAME=telegram-bot-token
CLIENT_SECRET_NAME=telegram-bot-keycloak-client-secret
API_TOKEN_SECRET_NAME=planazo-prod-telegram-api-token
WEBHOOK_SECRET_NAME=telegram-bot-webhook-secret
