{
  "name": "telegram",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de Telegram implementado como Cloud Function (GCP)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "gcp-build": "npm run build",
    "start": "npm run build && functions-framework --target=webhook --source=dist",
    "deploy": "bash scripts/deploy.sh",
    "dev": "concurrently -k -n tsc,fn \"tsc -w --preserveWatchOutput\" \"nodemon --watch dist --ext js --delay 500ms --exec functions-framework --target=webhook --source=dist --port=8080\""
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "concurrently": "^10.0.5",
    "nodemon": "^3.1.14",
    "typescript": "^5.5.4"
  }
}
