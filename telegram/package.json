{
  "name": "telegram",
  "version": "1.0.0",
  "private": true,
  "description": "Bot de Telegram implementado como Cloud Function (GCP)",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "gcp-build": "npm run build",
    "start": "npm run build && functions-framework --target=webhook --source=dist",
    "deploy": "bash scripts/deploy.sh"
  },
  "dependencies": {
    "@google-cloud/functions-framework": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.4"
  }
}
