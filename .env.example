# Optional overrides for docker compose. Defaults are suitable for local development.
WEATHER_PROVIDER=open-meteo
STORAGE_BUCKET=activity-images
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MONGO_INITDB_ROOT_USER=admin
MONGO_INITDB_ROOT_PASS=password123
MONGO_INITDB_DATABASE=mi_base_de_datos
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=keycloak
SECURITY_JWT_ISSUER_URI=http://localhost:8090/realms/solnotfound
SECURITY_JWT_JWK_SET_URI=http://keycloak:8080/realms/solnotfound/protocol/openid-connect/certs
SECURITY_JWT_AUDIENCE=solnotfoundBackend
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8090
NEXT_PUBLIC_KEYCLOAK_REALM=solnotfound
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=solnotfoundFrontend
# URL publica del realm: fija el issuer de los tokens que emite Keycloak. El backend lo valida
# contra SECURITY_JWT_ISSUER_URI.
KEYCLOAK_PUBLIC_URL=http://localhost:8090
# Dentro de la red de Compose el bot pide su token a Keycloak por la URL interna.
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
# Credenciales del cliente confidencial de la funcion del bot (rol de realm TELEGRAM_BOT).
KEYCLOAK_TELEGRAM_BOT_CLIENT_ID=solnotfoundTelegramBot
KEYCLOAK_TELEGRAM_BOT_CLIENT_SECRET=solnotfound-telegram-bot-client-secret
APP_SEED_ENABLED=false
TELEGRAM_BOT_TOKEN=
# API token que el bot envia en X-Api-Token. El backend exige este token y el JWT del bot.
TELEGRAM_API_TOKEN=
