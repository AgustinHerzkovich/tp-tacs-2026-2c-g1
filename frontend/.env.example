# Origin of the Spring Boot backend, used server-side only by the proxy
# routes under src/pages/api. Never read from client components.
BACKEND_URL=http://localhost:8080

# Public OIDC settings used by keycloak-js in the browser. A public SPA client
# must never have a client secret.
NEXT_PUBLIC_KEYCLOAK_URL=http://localhost:8090
NEXT_PUBLIC_KEYCLOAK_REALM=solnotfound
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=solnotfoundFrontend
